        <material>
          <ambient>0.18 0.18 0.18 1.0</ambient>
          <diffuse>0.18 0.18 0.18 1.0</diffuse>
        </material>
      </visual>
      <!-- Center Dashed Lines -->
      <visual name="line_1">
        <pose>-6.0 0 0.116 0 0 0</pose>
        <geometry><box><size>3.0 0.12 0.005</size></box></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
      </visual>
      <visual name="line_2">
