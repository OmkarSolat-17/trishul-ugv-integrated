<?xml version="1.0"?>
<sdf version="1.9">
  <model name="flyover_plate">
    <static>true</static>
    <link name="ramp_link">
      <!-- Incline Ramp Road Surface (Flush with flyover deck top at Z=2.7797m) -->
      <collision name="ramp_collision">
        <pose>0 0 0.0 0 0 0</pose>
        <geometry><box><size>24.0 8.0 0.228</size></box></geometry>
        <surface>
          <friction><ode/></friction>
          <bounce/>
          <contact/>
        </surface>
      </collision>
      <visual name="ramp_visual">
