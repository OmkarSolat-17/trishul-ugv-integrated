    <joint name="left_front_joint" type="revolute">
      <parent>chassis</parent>
      <child>left_front_wheel</child>
      <axis>
        <xyz expressed_in="chassis">0 1 0</xyz>
        <limit>
          <effort>120</effort>
          <velocity>35</velocity>
        </limit>
      </axis>
    </joint>
