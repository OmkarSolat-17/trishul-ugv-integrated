<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <model name="trishul_4wd_ugv">
    <link name="base_footprint"/>
    <link name="base_link">
      <pose>0 0 0.38 0 0 0</pose>
    </link>
    <joint name="base_footprint_joint" type="fixed">
      <parent>base_footprint</parent>
      <child>base_link</child>
    </joint>
    <joint name="base_link_chassis_joint" type="fixed">
      <parent>base_link</parent>
      <child>chassis</child>
    </joint>
    <self_collide>false</self_collide>
    <static>false</static>
    <link name="chassis">
      <pose>0 0 0.38 0 0 0</pose>
      <inertial>
        <pose>0 0 -0.20 0 0 0</pose>
        <mass>35</mass>
        <inertia>
          <ixx>1.2</ixx>
          <iyy>1.8</iyy>
          <izz>2.2</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="chassis_collision">
        <geometry>
          <box>
            <size>0.70 0.50 0.16</size>
          </box>
        </geometry>
      </collision>
      <visual name="chassis_visual">
        <geometry>
          <box>
            <size>0.70 0.50 0.16</size>
          </box>
        </geometry>
        <material>
          <ambient>0.14 0.18 0.22 1</ambient>
          <diffuse>0.20 0.26 0.32 1</diffuse>
        </material>
      </visual>
      <collision name="top_collision">
        <pose>0 0 0.12 0 0 0</pose>
        <geometry>
          <box>
            <size>0.30 0.26 0.08</size>
          </box>
        </geometry>
      </collision>
      <visual name="top_visual">
        <pose>0 0 0.12 0 0 0</pose>
        <geometry>
          <box>
            <size>0.30 0.26 0.08</size>
          </box>
        </geometry>
        <material>
          <ambient>0.20 0.22 0.25 1</ambient>
          <diffuse>0.28 0.30 0.35 1</diffuse>
        </material>
      </visual>
      <sensor name="intel_realsense_r200_rgb" type="camera">
        <pose>0.32 0 0.12 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
        <topic>/camera/color/image_raw</topic>
        <camera_info_topic>/camera/color/camera_info</camera_info_topic>
        <gz_frame_id>camera_rgb_frame</gz_frame_id>
        <camera name="realsense_rgb_camera">
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100.0</far>
          </clip>
        </camera>
      </sensor>
      <sensor name="intel_realsense_r200_depth" type="depth">
        <pose>0.32 0 0.12 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
        <topic>/camera/image_raw</topic>
        <camera_info_topic>/camera/camera_info</camera_info_topic>
        <gz_frame_id>camera_depth_frame</gz_frame_id>
        <camera name="realsense_depth_camera">
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>15.0</far>
          </clip>
        </camera>
      </sensor>
      <sensor name="rear_recon_camera" type="camera">
        <pose>-0.38 0 0.12 0 0 3.14159</pose>
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
        <topic>/camera/rear/image_raw</topic>
        <camera_info_topic>/camera/rear/camera_info</camera_info_topic>
        <gz_frame_id>base_footprint</gz_frame_id>
        <camera name="rear_recon_camera">
          <horizontal_fov>1.396</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>50.0</far>
          </clip>
        </camera>
      </sensor>
      <sensor name="front_lidar" type="gpu_lidar">
        <pose>0.18 0 0.20 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>8</update_rate>
        <visualize>true</visualize>
        <topic>/scan</topic>
        <gz_frame_id>base_scan</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.25</min>
            <max>20.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
      <sensor name="imu" type="imu">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <topic>/imu</topic>
        <gz_frame_id>imu_link</gz_frame_id>
      </sensor>
    <visual name="front_bumper"><pose>0.37 0 -0.02 0 0 0</pose><geometry><box><size>0.08 0.48 0.08</size></box></geometry><material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material></visual><visual name="rear_bumper"><pose>-0.37 0 -0.02 0 0 0</pose><geometry><box><size>0.08 0.48 0.08</size></box></geometry><material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material></visual><visual name="headlight_left"><pose>0.36 0.17 0.04 0 1.5707963 0</pose><geometry><cylinder><radius>0.04</radius><length>0.02</length></cylinder></geometry><material><ambient>1.0 1.0 0.8 1</ambient><diffuse>1.0 1.0 0.9 1</diffuse><emissive>0.9 0.9 0.7 1</emissive></material></visual><visual name="headlight_right"><pose>0.36 -0.17 0.04 0 1.5707963 0</pose><geometry><cylinder><radius>0.04</radius><length>0.02</length></cylinder></geometry><material><ambient>1.0 1.0 0.8 1</ambient><diffuse>1.0 1.0 0.9 1</diffuse><emissive>0.9 0.9 0.7 1</emissive></material></visual><visual name="taillight_left"><pose>-0.36 0.17 0.04 0 1.5707963 0</pose><geometry><cylinder><radius>0.03</radius><length>0.02</length></cylinder></geometry><material><ambient>0.8 0.05 0.05 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse><emissive>0.8 0.02 0.02 1</emissive></material></visual><visual name="taillight_right"><pose>-0.36 -0.17 0.04 0 1.5707963 0</pose><geometry><cylinder><radius>0.03</radius><length>0.02</length></cylinder></geometry><material><ambient>0.8 0.05 0.05 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse><emissive>0.8 0.02 0.02 1</emissive></material></visual><visual name="roll_bar_left"><pose>0 0.22 0.12 0 0 0</pose><geometry><box><size>0.50 0.03 0.12</size></box></geometry><material><ambient>0.10 0.10 0.10 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual><visual name="roll_bar_right"><pose>0 -0.22 0.12 0 0 0</pose><geometry><box><size>0.50 0.03 0.12</size></box></geometry><material><ambient>0.10 0.10 0.10 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual><visual name="sensor_turret_base"><pose>0.18 0 0.10 0 0 0</pose><geometry><cylinder><radius>0.06</radius><length>0.08</length></cylinder></geometry><material><ambient>0.18 0.18 0.20 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material></visual></link>
